---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals?.runtime?.env?.DB;
let allArticles = [];

if (db) {
  const { results } = await db.prepare("SELECT * FROM articles WHERE status = 'published' ORDER BY published_at DESC").all();
  allArticles = results || [];
}

const categories = ["mind", "islam", "philosophy", "history", "science", "technology", "world", "story", "uplift", "poetry", "sufi", "tasawuf", "aqidah", "akhlak", "fiqih"];
const categoryLabels = {
  mind: "🧠 Mind",
  islam: "🕌 Islam",
  philosophy: "🏛️ Philosophy",
  history: "🌍 History",
  science: "🔬 Science",
  technology: "💻 Technology",
  world: "📰 World",
  story: "📚 Story",
  uplift: "✨ Uplift",
  poetry: "🍃 Poetry",
  sufi: "🕯️ Sufi",
  tasawuf: "💫 Tasawwuf",
  aqidah: "📖 Creed",
  akhlak: "💖 Ethics",
  fiqih: "⚖️ Jurisprudence"
};
---
<BaseLayout title="Explore — Simple Reads" description="Browse reading categories based on your interests.">
<section class="section explore-section">
  <div class="hero compact-hero">
    <p class="eyebrow">LIBRARY</p>
    <h1>Browse Categories</h1>
    <p class="lead">Discover fresh perspectives based on the topics you want to explore.</p>
  </div>

  <!-- Horizontal Scrolling Category Selector for Quick Jump -->
  <div class="scroll-chips-wrapper">
    <div class="scroll-chips">
      <button class="md3-chip mood-filter-btn selected" onclick="filterMood('all')">🌟 All Moods</button>
      <button class="md3-chip mood-filter-btn" onclick="filterMood('ketenangan')">🌿 Calm</button>
      <button class="md3-chip mood-filter-btn" onclick="filterMood('analitis')">⚡ Analytical</button>
      <button class="md3-chip mood-filter-btn" onclick="filterMood('hikmah')">🕌 Wisdom & History</button>
    </div>
  </div>

  <div class="scroll-chips-wrapper" style="margin-top: -12px;">
    <div class="scroll-chips">
      {categories.map(cat => {
        const count = allArticles.filter(a => a.category === cat).length;
        return (
          <a href={`#cat-${cat}`} class="md3-chip">
            {categoryLabels[cat] || cat} <span class="badge">{count}</span>
          </a>
        );
      })}
    </div>
  </div>

  <!-- Compact Category List View -->
  <div class="category-list">
    {categories.map(cat => {
      const articles = allArticles.filter(a => a.category === cat);
      return (
        <div class="category-block" id={`cat-${cat}`}>
          <div class="block-header">
            <h2 class="block-title">{categoryLabels[cat] || cat}</h2>
            <span class="block-count">{articles.length} articles</span>
          </div>
          
          {articles.length === 0 ? (
            <p class="empty-cat-text">Coming soon — articles for this category are in preparation.</p>
          ) : (
            <ul class="article-title-list">
              {articles.slice(0, 4).map(article => (
                <li>
                  <a href={`/articles/${article.slug}`} class="article-list-item">
                    <span class="bullet">•</span>
                    <div class="item-details">
                      <span class="item-title">{article.title}</span>
                      <span class="item-desc">{article.description || "Read more..."}</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}
          
          {articles.length > 4 && (
            <a class="block-more-link" href={`/archive/?filter=${cat}`}>
              View all {articles.length} articles →
            </a>
          )}
        </div>
      );
    })}
  </div>
</section>
</BaseLayout>
